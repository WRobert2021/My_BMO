{
  "text_model": "gemma3:1b",
  "vision_model": "moondream",
  "voice_model": "piper/en_GB-semaine-medium.onnx",
  "chat_memory": true,
  "camera_rotation": 180,
  "system_prompt": null,
  "system_prompt_extras": "",
  "input_device": null,
  "input_sample_rate": 44100,
  "weather_units": "imperial",
  "online_timeout_seconds": 6,
  "interaction_logging": true,
  "interaction_log_directory": "interaction_logs",
  "modes": [
    {
      "module": "bmo.modes.matching_game",
      "enabled": true,
      "settings": {}
    },
    {
      "module": "bmo.modes.twenty_questions",
      "enabled": true,
      "settings": {
        "answer_wait_seconds": 12,
        "debug": false
      }
    }
  ],
  "features": [
    {
      "module": "bmo.features.get_time",
      "enabled": true,
      "settings": {}
    },
    {
      "module": "bmo.features.set_timer",
      "enabled": true,
      "settings": {
        "max_timers": 20,
        "max_duration_seconds": 604800
      }
    },
    {
      "module": "bmo.features.get_location",
      "enabled": true,
      "settings": {}
    },
    {
      "module": "bmo.features.get_weather",
      "enabled": true,
      "settings": {}
    },
    {
      "module": "bmo.features.search_web",
      "enabled": true,
      "settings": {}
    },
    {
      "module": "bmo.features.capture_image",
      "enabled": true,
      "settings": {}
    },
    {
      "module": "bmo.features.say_hello",
      "enabled": false,
      "settings": {
        "greeting": "Hello!"
      }
    }
  ]
}
